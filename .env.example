# 复制为 .env 后替换所有口令为随机生成的值（严禁提交真实密钥）
POSTGRES_DB=bloodquest
POSTGRES_USER=bloodquest
POSTGRES_PASSWORD=CHANGE_TO_A_RANDOM_DB_PASSWORD
APP_SECRET=CHANGE_TO_A_RANDOM_SECRET_MINIMUM_32_CHARS
SUPERADMIN_PASSWORD=CHANGE_TO_A_STRONG_ADMIN_PASSWORD
DRAW_OPENS_AT=2026-10-28T15:00:00+08:00
# 演示时 true；正式开放公网前必须 false
DEMO_MODE=true
PUBLIC_BASE_URL=http://127.0.0.1:8080
COOKIE_SECURE=false
LEADERBOARD_LIMIT=100
# 正式微信公众号授权需具备相应网页授权权限，并配置 HTTPS 回调域名
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 默认只监听服务器回环地址，请通过现有 HTTPS 反向代理暴露公网
HTTP_BIND=127.0.0.1
